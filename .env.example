# ==============================================================================
# Rubik's Cube Race Benchmark - Environment Configuration
# Copy this file to .env and configure your credentials if testing live models.
# ==============================================================================

# ------------------------------------------------------------------------------
# OpenRouter API Authentication
# Paste your personal OpenRouter API key below.
# Never commit your real .env file with active keys to version control.
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ------------------------------------------------------------------------------
# Execution Mode & Cost Guardrails
# Default is 'true' ($0 Cost Simulated / Offline Benchmark Mode).
# Set to 'false' only when you wish to execute real live API calls against OpenRouter.
# ------------------------------------------------------------------------------
OPENROUTER_MOCK_MODE=true

# Hard session call budget guardrail to prevent unexpected API charges:
# If this limit is reached, all subsequent live calls are blocked automatically.
MAX_LIVE_API_CALLS_PER_SESSION=5


# Max retries on network/schema errors in live mode (kept to 1 to avoid paying 3x tokens)
OPENROUTER_MAX_RETRIES=1

# Network timeout per API call in seconds
OPENROUTER_TIMEOUT_SECONDS=15.0

# Base URL for OpenRouter API
OPENROUTER_BASE_URL=https://openrouter.ai

# ------------------------------------------------------------------------------
# Model Registry ID Overrides (Optional)
# ------------------------------------------------------------------------------
MODEL_ID_JEV=typesafe/jev-1.13
MODEL_ID_LUNA=openai/gpt-6-luna-decisions
MODEL_ID_CLEF=cloudflare/clef
MODEL_ID_CLAUDE=anthropic/claude-opus-5.5

# ------------------------------------------------------------------------------
# Server Configuration
# ------------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# Benchmark Engine Defaults
# ------------------------------------------------------------------------------
DEFAULT_SCRAMBLE_LENGTH=4
MAX_BFS_DEPTH=7

